// Instant Mechanic — operations database.
//
// The BookingStatus / ServiceCategory enums below are mirrored in
// packages/shared/src/enums.ts so the web app can use them without pulling in
// the generated Prisma client. Keep the two in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  PERIODIC_SERVICE
  BREAKDOWN_ASSISTANCE
  BATTERY
  TYRES_AND_WHEELS
  BRAKES_AND_SUSPENSION
  AC_SERVICE
  DENT_AND_PAINT
  INSPECTION
}

enum UserRole {
  ADMIN
  DISPATCHER
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())

  vehicles Vehicle[]
  bookings Booking[]

  @@map("customers")
}

model Vehicle {
  id         String @id @default(cuid())
  customerId String
  make       String
  model      String
  year       Int
  plate      String @unique

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id            String          @id @default(cuid())
  name          String
  category      ServiceCategory
  /// Current list price in INR. Bookings snapshot this value at creation time.
  basePrice     Decimal         @db.Decimal(10, 2)
  estimatedMins Int

  bookings Booking[]

  @@index([category])
  @@map("services")
}

model Mechanic {
  id        String          @id @default(cuid())
  name      String
  phone     String
  specialty ServiceCategory
  /// 1.0 - 5.0
  rating    Float           @default(5)
  onDuty    Boolean         @default(true)
  joinedAt  DateTime        @default(now())

  bookings Booking[]

  @@index([onDuty])
  @@map("mechanics")
}

model Booking {
  id         String        @id @default(cuid())
  /// Human-readable reference shown to customers and dispatchers, e.g. "IM-2026-0412".
  code       String        @unique
  customerId String
  vehicleId  String
  serviceId  String
  mechanicId String?
  status     BookingStatus @default(PENDING)
  /// Amount charged in INR, snapshotted from Service.basePrice when the booking is
  /// created. Deliberately NOT a lookup: list prices change and historical revenue
  /// must not move with them.
  amount      Decimal  @db.Decimal(10, 2)
  scheduledAt DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  mechanic Mechanic? @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  events BookingEvent[]

  @@index([status])
  @@index([scheduledAt])
  @@index([mechanicId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("bookings")
}

model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

/// Dashboard operator. Auth (JWT) lands in a later task; this table exists so the
/// seeded admin credentials are already in place.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())

  @@map("users")
}
