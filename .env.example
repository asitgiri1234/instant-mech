# ---------------------------------------------------------------------------
# Instant Mechanic — local environment template
# Copy to .env and adjust.  .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres. docker-compose maps container 5432 -> host 5455; 5432 and the ports
# just above it are often already taken by other local Postgres instances.
POSTGRES_USER=instantmech
POSTGRES_PASSWORD=instantmech
POSTGRES_DB=instantmech
POSTGRES_PORT=5455

DATABASE_URL="postgresql://instantmech:instantmech@localhost:5455/instantmech?schema=public"

# API
API_PORT=4000
NODE_ENV=development

# JWT (auth is not implemented yet — reserved for the next task)
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=7d

# Seeded admin user — created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@instantmechanic.in
SEED_ADMIN_PASSWORD=InstantMech@2026

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
